{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1440px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "teal",       "color": "#1BADA6", "name": "Teal" },
        { "slug": "teal-dark",  "color": "#158f89", "name": "Teal Dark" },
        { "slug": "dark",       "color": "#141414", "name": "Dark" },
        { "slug": "dark-2",     "color": "#1a1e1b", "name": "Dark Two" },
        { "slug": "dark-3",     "color": "#12160f", "name": "Dark Three" },
        { "slug": "warm-white", "color": "#F5F3EF", "name": "Warm White" },
        { "slug": "olive",      "color": "#344030", "name": "Olive" },
        { "slug": "white",      "color": "#ffffff", "name": "White" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "'Cormorant Garant', serif",
          "slug": "display",
          "name": "Cormorant Garant"
        },
        {
          "fontFamily": "'DM Sans', sans-serif",
          "slug": "body",
          "name": "DM Sans"
        }
      ],
      "fontSizes": [
        { "slug": "xs",       "size": "0.72rem",                    "name": "XS" },
        { "slug": "small",    "size": "0.875rem",                   "name": "Small" },
        { "slug": "medium",   "size": "1rem",                       "name": "Medium" },
        { "slug": "large",    "size": "1.25rem",                    "name": "Large" },
        { "slug": "x-large",  "size": "1.75rem",                    "name": "Extra Large" },
        { "slug": "xx-large", "size": "2.5rem",                     "name": "2X Large" },
        { "slug": "huge",     "size": "clamp(2.75rem,6vw,5.5rem)",  "name": "Huge" }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "%", "vw", "vh"],
      "spacingSizes": [
        { "slug": "10", "size": "0.5rem",  "name": "XS" },
        { "slug": "20", "size": "1.125rem","name": "Small" },
        { "slug": "30", "size": "2rem",    "name": "Medium" },
        { "slug": "40", "size": "3rem",    "name": "Large" },
        { "slug": "50", "size": "5rem",    "name": "XL" },
        { "slug": "60", "size": "6rem",    "name": "XXL" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--warm-white)",
      "text":       "var(--wp--preset--color--dark)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize":   "var(--wp--preset--font-size--medium)",
      "lineHeight":  "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "lineHeight": "1.12"
        }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--teal)" },
        ":hover": { "color": { "text": "var(--wp--preset--color--teal-dark)" } }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--teal)",
          "text":       "var(--wp--preset--color--white)"
        },
        "border": { "radius": "0" },
        "typography": {
          "fontFamily":    "var(--wp--preset--font-family--body)",
          "fontWeight":    "500",
          "fontSize":      "0.775rem",
          "letterSpacing": "0.07em",
          "textTransform": "uppercase"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--teal-dark)",
            "text":       "var(--wp--preset--color--white)"
          }
        }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
